# ==========================================
# RELAY - Environment Configuration
# ==========================================

# ------------------------------------------
# Groq
# ------------------------------------------
GROQ_API_KEY=

# ------------------------------------------
# Gemini
# ------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------
# OpenRouter
# ------------------------------------------
OPENROUTER_API_KEY=

# ------------------------------------------
# RELAY Configuration
# ------------------------------------------

# Default provider order
RELAY_PROVIDER_ORDER=groq,gemini,openrouter

# Default request timeout in seconds
RELAY_TIMEOUT=30

# Maximum number of provider attempts
RELAY_MAX_ATTEMPTS=3

# Enable automatic failover
RELAY_ENABLE_FAILOVER=true

# Environment
RELAY_ENVIRONMENT=development